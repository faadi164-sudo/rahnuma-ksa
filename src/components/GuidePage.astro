---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { SITE, url, formatDate } from '../site';
import { hubBySlug } from '../data/hubs';
import { T } from '../i18n';
import { type Guide, getGuides, guidePath, findTranslation } from '../lib/guides';

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const d = guide.data;
const lang = d.lang;
const ur = lang === 'ur';
const t = T[lang];
const hub = hubBySlug(d.hub)!;
const path = guidePath(guide);
const translation = await findTranslation(guide);
const related = (await getGuides(lang)).filter((g) => g.data.hub === d.hub && g.id !== guide.id).slice(0, 4);
const { Content } = await render(guide);
const abs = (p: string) => new URL(url(p), Astro.site).href;
const homePath = ur ? 'ur/' : '';
const hubPath = `${ur ? 'ur/' : ''}topics/${hub.slug}/`;
const reportHref = `mailto:${SITE.email}?subject=${encodeURIComponent('Error report: ' + d.title)}&body=${encodeURIComponent(abs(path))}`;

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': d.type === 'news' ? 'NewsArticle' : 'Article',
    headline: d.title,
    description: d.description,
    inLanguage: lang,
    datePublished: d.published.toISOString(),
    dateModified: d.lastChecked.toISOString(),
    author: { '@type': 'Person', name: SITE.owner },
    publisher: { '@type': 'Organization', name: SITE.name },
    mainEntityOfPage: abs(path),
    citation: d.sources.map((s) => s.url),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.home, item: abs(homePath) },
      { '@type': 'ListItem', position: 2, name: ur ? hub.ur : hub.en, item: abs(hubPath) },
      { '@type': 'ListItem', position: 3, name: d.title, item: abs(path) },
    ],
  },
];
if (d.faq.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base
  lang={lang}
  path={path}
  altPath={translation ? guidePath(translation) : undefined}
  title={d.title}
  description={d.description}
  schema={schema}
  ogType="article"
  noindex={d.draft}
>
  <div class="page-head">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb">
          <li><a href={url(homePath)}>{t.home}</a></li>
          <li><a href={url(hubPath)}>{ur ? hub.ur : hub.en}</a></li>
        </ol>
      </nav>
      <h1>{d.title}</h1>
      <div class="meta">
        <span class="checked"><Icon name="check" size={16} stroke={2} />{t.lastChecked}: <time datetime={d.lastChecked.toISOString().slice(0, 10)}>{formatDate(d.lastChecked, lang)}</time></span>
        {translation && <a href={url(guidePath(translation))} lang={ur ? 'en' : 'ur'}>{t.readInOther}</a>}
        {d.draft && <span class="badge badge-amber">DRAFT — not published</span>}
      </div>
    </div>
  </div>

  <div class="container">
    <div class="guide-wrap">
      <section class="quick-answer" aria-labelledby="quick-answer">
        <h2 id="quick-answer">{t.quickAnswer}</h2>
        <p>{d.quickAnswer}</p>
      </section>

      <article class="prose">
        <Content />
      </article>

      {d.faq.length > 0 && (
        <section class="faq" aria-labelledby="faq">
          <h2 id="faq">{t.faq}</h2>
          {d.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </section>
      )}

      <section class="sources" aria-labelledby="sources">
        <h2 id="sources">{t.sources}</h2>
        <ul>
          {d.sources.map((s) => (
            <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>
          ))}
        </ul>
      </section>

      <div class="notice">
        <Icon name="info" />
        <div>
          <p style="margin: 0">{t.disclaimer}</p>
          <p style="margin: 8px 0 0" class="report"><a href={reportHref}>{t.reportError}</a></p>
        </div>
      </div>

      {related.length > 0 && (
        <section class="related" aria-labelledby="related">
          <h2 id="related">{t.related}</h2>
          <div class="link-list">
            {related.map((g) => (
              <a class="link-row" href={url(guidePath(g))}><span class="title">{g.data.title}</span></a>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Base>
