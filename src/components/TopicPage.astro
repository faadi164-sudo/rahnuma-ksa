---
import PhotoBg from './PhotoBg.astro';
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import { SITE, url, formatDate, HAS_WHATSAPP } from '../site';
import { type Hub } from '../data/hubs';
import { getGuides, guidePath } from '../lib/guides';
import { T } from '../i18n';
import { HUB_INTROS } from '../data/hub-intros';

interface Props {
  hub: Hub;
  lang: 'en' | 'ur';
}
const { hub, lang } = Astro.props;
const ur = lang === 'ur';
const t = T[lang];
const guides = (await getGuides(lang)).filter((g) => g.data.hub === hub.slug);
// Urdu pages also list English guides that have no Urdu version yet, so no topic page is empty.
const translatedKeys = new Set(guides.map((g) => g.data.translationKey).filter(Boolean));
const englishOnly = ur
  ? (await getGuides('en')).filter((g) => g.data.hub === hub.slug && !(g.data.translationKey && translatedKeys.has(g.data.translationKey)))
  : [];
const intro = HUB_INTROS[hub.slug];
// "Start here" links: a guide in this language if it exists, else the English one; or a calculator.
const allEn = await getGuides('en');
const start = intro.start.map((key) => {
  if (key.startsWith('tools/')) {
    return { href: url(`${ur ? 'ur/' : ''}${key}/`), title: ur ? 'اقامہ فیس کیلکولیٹر' : 'Iqama fee calculator', en: false };
  }
  const own = guides.find((g) => g.id.split('/').pop() === key);
  const g = own ?? allEn.find((x) => x.id.split('/').pop() === key);
  return g ? { href: url(guidePath(g)), title: g.data.title, en: ur && !own } : null;
}).filter(Boolean) as { href: string; title: string; en: boolean }[];
const path = `${ur ? 'ur/' : ''}topics/${hub.slug}/`;
const altPath = `${ur ? '' : 'ur/'}topics/${hub.slug}/`;
---
<Base
  lang={lang}
  path={path}
  altPath={altPath}
  title={ur ? hub.ur : hub.en}
  description={ur ? `${hub.ur}: ${intro.blurbUr}` : hub.blurb}
>
  <div class="page-head has-photo">
    <PhotoBg name={hub.slug} />
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb"><li><a href={url(ur ? 'ur/' : '')}>{t.home}</a></li></ol>
      </nav>
      <h1>{ur ? hub.ur : hub.en}</h1>
      <p class="sub">{ur ? intro.blurbUr : hub.blurb}</p>
    </div>
  </div>
  <div class="container" style="padding-top: 32px; padding-bottom: 56px; max-width: 900px">
    <section class="prose hub-intro">
      {(ur ? intro.ur : intro.en).map((para) => <p>{para}</p>)}
      {start.length > 0 && (
        <>
          <h2>{ur ? 'یہاں سے شروع کریں' : 'Start here'}</h2>
          <ul>
            {start.map((s) => <li><a href={s.href} lang={s.en ? 'en' : undefined} dir={s.en ? 'ltr' : undefined}>{s.title}</a></li>)}
          </ul>
        </>
      )}
      <h2>{ur ? 'اس موضوع پر تمام رہنمائیاں' : 'All guides on this topic'}</h2>
    </section>
    {guides.length > 0 && (
      <div class="link-list">
        {guides.map((g) => (
          <a class="link-row" href={url(guidePath(g))}>
            <span class="title">{g.data.title}</span>
            <span class="checked"><Icon name="check" size={16} stroke={2} />{formatDate(g.data.lastChecked, lang)}</span>
          </a>
        ))}
      </div>
    )}
    {englishOnly.length > 0 && (
      <>
        <p class="fallback-note">{guides.length > 0 ? 'یہ رہنمائیاں ابھی صرف انگریزی میں ہیں، اردو ترجمہ جلد آ رہا ہے:' : 'اس موضوع پر اردو رہنمائی جلد آ رہی ہے۔ تب تک یہ انگریزی رہنمائیاں دیکھیں:'}</p>
        <div class="link-list" lang="en" dir="ltr">
          {englishOnly.map((g) => (
            <a class="link-row" href={url(guidePath(g))}>
              <span class="title">{g.data.title}</span>
              <span class="checked">English</span>
            </a>
          ))}
        </div>
      </>
    )}
    {guides.length === 0 && englishOnly.length === 0 && (
      <div class="empty">
        <p style="margin: 0">
          {ur
            ? 'اس موضوع پر پہلی رہنمائیاں لکھی جا رہی ہیں۔'
            : 'We are writing and checking the first guides for this topic.'}
        </p>
        {HAS_WHATSAPP && <p style="margin: 14px 0 0"><a class="btn btn-primary" href={SITE.whatsappUrl}><Icon name="chat" size={18} />{t.whatsapp}</a></p>}
      </div>
    )}
  </div>
</Base>
