---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../site';
import { HUBS } from '../data/hubs';
---
<Base title="Page not found" description="This page does not exist." path="404/" noindex>
  <div class="page-head">
    <div class="container">
      <h1>We could not find that page</h1>
      <p class="sub">It may have moved. Search for what you need, or pick a topic.</p>
      <form class="search-form" role="search" action={url('search/')} method="get">
        <label class="search-field">
          <Icon name="search" />
          <span class="sr-only">Search guides</span>
          <input type="search" name="q" placeholder="e.g. renew iqama" />
        </label>
        <button class="btn btn-primary" type="submit">Search</button>
      </form>
    </div>
  </div>
  <div class="container" style="padding-top: 32px; padding-bottom: 56px">
    <div class="topics">
      {HUBS.map((h) => <a class="topic" href={url(`topics/${h.slug}/`)}>{h.en}</a>)}
    </div>
  </div>
</Base>
