---
import Base from './Base.astro';
import ShareBar from '../components/ShareBar.astro';
import { url } from '../site';

interface Props {
  title: string;
  description: string;
  slug: string;
  intro: string;
  sources: { name: string; url: string }[];
  lastChecked: string;
  lang?: 'en' | 'ur';
}

const { title, description, slug, intro, sources, lastChecked, lang = 'en' } = Astro.props;
const ur = lang === 'ur';
const L = (en: string, u: string) => (ur ? u : en);
const home = ur ? 'ur/' : '';
const toolsPath = `${home}tools/`;
const path = `${toolsPath}${slug}/`;
const altPath = `${ur ? '' : 'ur/'}tools/${slug}/`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    description,
    inLanguage: lang,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'SAR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: L('Home', 'ہوم'), item: new URL(url(home), Astro.site).href },
      { '@type': 'ListItem', position: 2, name: L('Free tools', 'مفت ٹولز'), item: new URL(url(toolsPath), Astro.site).href },
      { '@type': 'ListItem', position: 3, name: title },
    ],
  },
];
---
<Base title={title} description={description} lang={lang} path={path} altPath={altPath} schema={schema} ogImage={`og/${lang}/tool-${slug}.jpg`}>
  <div class="page-head">
    <div class="container">
      <nav aria-label={L('Breadcrumb', 'راستہ')}>
        <ol class="breadcrumb">
          <li><a href={url(home)}>{L('Home', 'ہوم')}</a></li>
          <li><a href={url(toolsPath)}>{L('Free tools', 'مفت ٹولز')}</a></li>
        </ol>
      </nav>
      <h1>{title}</h1>
      <p class="sub">{intro}</p>
    </div>
  </div>
  <div class="container tool-wrap">
    <slot />
    <ShareBar title={title} link={new URL(url(path), Astro.site).href} lang={lang} />
    <section class="tool-notes prose">
      <slot name="notes" />
      <h2>{L('Sources', 'ذرائع')}</h2>
      <ul>
        {sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank" lang="en" dir="ltr">{s.name}</a></li>)}
      </ul>
      <p class="tool-checked">
        {L(
          `Rules last checked: ${lastChecked}. Results are estimates to help you plan; the official portal decides the final amount.`,
          `قواعد کی آخری تصدیق: ${lastChecked}۔ نتائج منصوبہ بندی کے لیے اندازہ ہیں؛ حتمی رقم سرکاری پورٹل ہی طے کرتا ہے۔`,
        )}
      </p>
    </section>
  </div>
</Base>
