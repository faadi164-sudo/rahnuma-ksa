---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, url } from '../site';
import { T } from '../i18n';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ur';
  /** Path of this page without the base, e.g. "" or "guides/renew-iqama/". */
  path: string;
  /** Path of the same page in the other language, if one exists. */
  altPath?: string;
  schema?: object[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, lang = 'en', path, altPath, schema = [], noindex = false, ogType = 'website' } = Astro.props;
const t = T[lang];
const abs = (p: string) => new URL(url(p), Astro.site).href;
const canonical = abs(path);
const isHome = path === '' || path === 'ur/';
const fullTitle = isHome ? title : `${title} | ${SITE.name}`;
const enPath = lang === 'en' ? path : altPath;
const urPath = lang === 'ur' ? path : altPath;
---
<!doctype html>
<html lang={lang} dir={lang === 'ur' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {enPath !== undefined && urPath !== undefined && (
      <>
        <link rel="alternate" hreflang="en" href={abs(enPath)} />
        <link rel="alternate" hreflang="ur" href={abs(urPath)} />
        <link rel="alternate" hreflang="x-default" href={abs(enPath)} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'ur' ? 'ur_PK' : 'en_GB'} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0e2a23" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@700;800&family=Noto+Nastaliq+Urdu:wght@400;600&display=swap"
    />
    {/* After AdSense approval: add the AdSense script here and set SITE.adsEnabled = true. */}
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header lang={lang} enPath={enPath} urPath={urPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
