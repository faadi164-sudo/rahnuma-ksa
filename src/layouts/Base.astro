---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, url } from '../site';
import { T } from '../i18n';
import fs from 'node:fs';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ur';
  /** Path of this page without the base, e.g. "" or "guides/renew-iqama/". */
  path: string;
  /** Path of the same page in the other language, if one exists. */
  altPath?: string;
  schema?: object[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Preview image path under public/, e.g. og/en/iqama-fees.jpg. Falls back to the default card. */
  ogImage?: string;
}

const { title, description, lang = 'en', path, altPath, schema = [], noindex = false, ogType = 'website', ogImage } = Astro.props;
const fontsHref = `https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@700;800${lang === 'ur' ? '&family=Noto+Nastaliq+Urdu:wght@400;600' : ''}&display=swap`;
const fallbackOg = `og/default-${lang}.jpg`;
const ogFile = ogImage && fs.existsSync(`public/${ogImage}`) ? ogImage : fallbackOg;
const t = T[lang];
const abs = (p: string) => new URL(url(p), Astro.site).href;
const canonical = abs(path);
const isHome = path === '' || path === 'ur/';
// Add the site name only when the title still fits in search results (about 60 characters).
const fullTitle = isHome || title.length + SITE.name.length + 3 > 62 ? title : `${title} | ${SITE.name}`;
const enPath = lang === 'en' ? path : altPath;
const urPath = lang === 'ur' ? path : altPath;
---
<!doctype html>
<html lang={lang} dir={lang === 'ur' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    {SITE.googleTagId && import.meta.env.PROD && (
      <>
        {/* The Google tag loads after the page is usable: on the first scroll, tap or key press, or 3 seconds after load. */}
        <script is:inline data-tag-id={SITE.googleTagId}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          (function (id) {
            var loaded = false;
            function load() {
              if (loaded) return;
              loaded = true;
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtm.js?id=' + id;
              document.head.appendChild(s);
            }
            ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (e) {
              window.addEventListener(e, load, { once: true, passive: true });
            });
            window.addEventListener('load', function () { setTimeout(load, 3000); });
          })(document.currentScript.dataset.tagId);
        </script>
      </>
    )}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {enPath !== undefined && urPath !== undefined && (
      <>
        <link rel="alternate" hreflang="en" href={abs(enPath)} />
        <link rel="alternate" hreflang="ur" href={abs(urPath)} />
        <link rel="alternate" hreflang="x-default" href={abs(enPath)} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === 'ur' ? 'ur_PK' : 'en_GB'} />
    <meta property="og:image" content={abs(ogFile)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={abs(ogFile)} />
    <meta name="theme-color" content="#0e2a23" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Fonts load without blocking the first paint. The Urdu font is only requested on Urdu pages. */}
    <link rel="preload" as="style" href={fontsHref} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={fontsHref} /></noscript>
    {/* AdSense site verification. The ad script itself is added only after approval (SITE.adsEnabled). */}
    {SITE.adsensePublisher && <meta name="google-adsense-account" content={SITE.adsensePublisher} />}
    {/* The AdSense script also shows Google's consent message (published for livingksa.com) to visitors in the EEA, UK and Switzerland. */}
    {SITE.adsEnabled && SITE.adsensePublisher && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsensePublisher}`} crossorigin="anonymous" />}
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <Header lang={lang} enPath={enPath} urPath={urPath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
